# Copy to .dev.vars and fill in. That file is gitignored and holds the values this repo
# deliberately does not carry: the stop, the deployed origin, and the secrets.
#
# Production equivalents are set with `npx wrangler secret put NAME`, never through the
# Cloudflare dashboard's Variables UI — `wrangler deploy` wipes those.
#
# Everything that is neither secret nor privacy-sensitive lives in `[vars]` in `wrangler.toml`
# instead. See docs/deploying.md.

# The agency that owns the stop pole. Agency IDs in the Puget Sound OneBusAway deployment,
# queried live 2026-08-01 from `agencies-with-coverage.json`. One key and one endpoint cover
# all of them:
#
#    1  Metro Transit (King County Metro)     40  Sound Transit (Link + ST Express)
#    3  Pierce Transit                        51  Amtrak
#   19  Intercity Transit                     95  Washington State Ferries
#   20  Kitsap Transit                        96  Seattle Center Monorail
#   23  City of Seattle (streetcar)           97  Everett Transit
#   29  Community Transit
#
# The prefix is the stop's owner, not the routes serving it — a `1_` stop returns Sound
# Transit routes too, so ST Express buses need no second agency. Link is the exception, since
# stations are their own `40_` stops.
DEV_AGENCY_ID=

# One or two stop IDs, comma separated, without the agency prefix — the same shape as the
# `stop` segment of the device's base URL. Two is the opposite-directions case; opposite
# directions are separate stops in OneBusAway, not a field on one stop.
#
# Kept out of the repo because a single stop implies a home address.
# e.g., `600,430` would show 3rd Ave & Virginia St, and 3rd Ave & Pine St, respectively.
DEV_STOP_ID=

# Deployed Worker origin, e.g. https://<worker>.<subdomain>.workers.dev
WORKER_ORIGIN=

# Shared secret for the URL path segment. Generate with `openssl rand -hex 32`.
DEVICE_TOKEN=

# Enables the local design preview at http://localhost:8788/_preview — a contact sheet of every
# sample board, re-rendered on each reload.
#
# This belongs here and nowhere else. `wrangler dev` reads `.dev.vars`; `wrangler deploy` never
# uploads it, so the variable simply does not exist in production and the preview routes 404 like
# everything else. Do NOT move it into `[vars]` in `wrangler.toml` — that block IS deployed.
DEV_PREVIEW=1

# OneBusAway Puget Sound API key. Sound Transit is the only issuer — OBA is open-source
# software with no central key authority, and the Puget Sound deployment is theirs:
# https://www.soundtransit.org/Open-Transit-Data
# `TEST` works for development but is heavily rate-limited (HTTP 429). Do not ship on it.
OBA_API_KEY=

# Per-stop direction labels, as JSON keyed by full OBA stop ID — the agency prefix is required
# here even though the agency is set separately:
#
#   DIRECTION_OVERRIDES={"1_590":"Northbound","1_430":"Southbound"}
#
# OneBusAway reports a compass bearing and never a word, so the label is derived: N becomes
# "Northbound", NW becomes "Northwest bound". That is correct for every stop in the region with
# no lookup table. This replaces it only where the bearing itself misleads — 3rd Ave runs
# diagonally, so its stops report NW/SE where every rider says northbound. Most stops need no
# entry. Keep it to a few; a county-wide table defeats the point of deriving the label.
#
# It lives here and not in `[vars]` for the same reason DEV_STOP_ID does: a map keyed by the stop
# this sign points at is a home address, and `wrangler.toml` is committed. Set it in production
# with `npx wrangler secret put DIRECTION_OVERRIDES`. Malformed JSON degrades to no overrides
# rather than failing a render.
#
# The sample boards have their own overrides in `src/dev/sample-boards.js` — those stops are
# public downtown ones chosen precisely so they can be written down.
DIRECTION_OVERRIDES=

# Password for the `/stats` page, prompted for over HTTP Basic. The username is ignored.
#
# This is the only brute-forceable secret in the project — DEVICE_TOKEN is 32 random bytes, while
# this is something a person types. A wrong password is therefore tarpitted for 25 seconds and
# recorded as `stats-auth-failed`, so guessing attempts are both slow and visible on the page
# itself. Generate something long: `openssl rand -base64 24`.
#
# An unset value never authenticates — the comparison refuses empty strings rather than degenerating
# into an open page. So leaving this blank locks the page rather than unlocking it.
STATS_PASSWORD=

# Which Cloudflare account holds the stats, needed to build the SQL API URL that reads them back.
#
# Not a credential — it appears in every dashboard URL — but it is kept out of `wrangler.toml`
# because that file is committed and this repo is public, and a fork needs its own value anyway.
# Set it in production with `npm run secret -- CLOUDFLARE_ACCOUNT_ID`.
#
# **This must be the account the Worker is deployed to.** If it names a different one, `/stats` reads
# an account the data was never written to and shows nothing while looking perfectly healthy.
#
# It also has to appear a second time, in `.cloudflare.env`, and that is not redundancy: this copy is
# a Worker binding read by our code, while that one tells the wrangler CLI which account to act on.
# Neither is in git. Omitting the `.cloudflare.env` copy is how a deploy silently lands on whichever
# account `wrangler login` last cached.
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token used to READ the stats back, scoped to Account Analytics: Read and nothing
# else. Create it at dash.cloudflare.com under My Profile, API Tokens.
#
# **Separate from the `CLOUDFLARE_API_TOKEN` in `.cloudflare.env`**, which is wrangler's own deploy
# credential and needs `Workers Scripts: Edit`. Two different tokens, same generic name in the
# Cloudflare UI — the easiest mix-up here.
#
# Needed because Analytics Engine is written through a Worker binding but read through Cloudflare's
# SQL HTTP API, which takes a bearer token. That API also sends no CORS headers, which is why the
# Worker queries it server-side instead of the page fetching it directly.
#
# Not required for anything the device does. Without it the sign works normally and only `/stats`
# shows an explanatory banner.
ANALYTICS_API_TOKEN=
